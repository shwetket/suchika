# .gitattributes
# Ensures correct line endings when cloning on Windows vs Linux/Codespaces.

# Default: auto-detect text files, normalize to LF in the repo
* text=auto eol=lf

# Windows-only scripts — keep CRLF on checkout for Windows users
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts and gradlew — MUST be LF on all platforms for execution on Linux/Codespaces
*.sh   text eol=lf
gradlew text eol=lf

# Java / Kotlin source
*.java     text eol=lf
*.kt       text eol=lf
*.kts      text eol=lf
*.gradle   text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.sql      text eol=lf
*.md       text eol=lf
*.properties text eol=lf

# Binary files — never modify line endings
*.jar    binary
*.class  binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.gif    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary
