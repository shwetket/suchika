{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@pages/*": ["src/pages/*"],
      "@api/*": ["src/api/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@context/*": ["src/context/*"],
      "@assets/*": ["../assets/*"]
    },
    "target": "ES2020",
    "lib": ["ES2020", "dom", "dom.iterable"]
  },
  "include": ["src"]
}
