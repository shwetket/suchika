{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "core-js-pure": "^3.21.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prebuild": "node scripts/copy-assets.js",
    "prestart": "node scripts/copy-assets.js",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "generate:api": "openapi-typescript ../application/contract/gateway.yaml --output src/api/generated.ts",
    "lint": "eslint src/ --ext .js,.jsx",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "format": "prettier --write src/ public/",
    "format:check": "prettier --check src/ public/",
    "prepare": "husky install",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.0",
    "openapi-typescript": "^6.7.6",
    "prettier": "^3.8.3",
    "typescript": "^4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
