# Local environment template — copy to application/finance/.env and fill in values.
# A single PostgreSQL database serves all domains via schemas.
# Run application/flyway/00_bootstrap.sql as superuser BEFORE starting any module.

DB_URL=jdbc:postgresql://localhost:5432/app_db
DB_USERNAME=app_user
DB_PASSWORD=your_secure_password_here

# Timezone — all timestamps stored and displayed in IST regardless of server OS timezone.
# This must match quarkus.hibernate-orm.jdbc.timezone in each service's application.properties.
TZ=Asia/Kolkata

# ── Port registry (for reference — ports are hardcoded in each service's application.properties) ──
# Web Frontend (React)   → http://localhost:3000
# Web Gateway (BFF)      → http://localhost:8080   (frontend calls this)
# Profile service        → http://localhost:8081   (start this FIRST)
# Wealth service         → http://localhost:8082
# Health service         → http://localhost:8083
# Household service      → http://localhost:8084
# PostgreSQL             → localhost:5432

# Override downstream service URLs in gateway if running on non-default ports:
# PROFILE_SERVICE_URL=http://localhost:8081
# WEALTH_SERVICE_URL=http://localhost:8082
# HEALTH_SERVICE_URL=http://localhost:8083
# HOUSEHOLD_SERVICE_URL=http://localhost:8084
